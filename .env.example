# Copy to .env and fill in. Never commit .env.

# Shared secret required on every /api/* request. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# First dashboard login, created on first DB init. Leave blank to create no user.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Port the server listens on (default 5000).
# PORT=5000

# Set to true only when running behind a reverse proxy that sets X-Forwarded-*.
# TRUST_PROXY=false

# Flask debugger/reloader. Local development only; never on a public host.
# FLASK_DEBUG=false

# Directory holding the DB, token.json and credentials.json (the Docker image sets /data).
# DATA_DIR=./data

# Overrides for individual file locations (default to inside DATA_DIR).
# DB_PATH=
# TOKEN_PATH=
# CREDENTIALS_PATH=

# Address the Gmail OAuth callback (port 8765) binds to (the Docker image sets 0.0.0.0).
# OAUTH_BIND_ADDR=localhost

# When set on the ingestion machine, transactions are POSTed to this hosted API instead of a local DB.
# REMOTE_API_URL=https://example.com

# Secret for the GitHub push webhook (/push) used for self-deploy.
# GITHUB_WEBHOOK_SECRET=

# Self-deploy: repo checkout to git pull, and the file to touch to reload the app.
# DEPLOY_REPO_DIR=
# DEPLOY_RELOAD_FILE=
